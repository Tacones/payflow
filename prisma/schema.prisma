generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients   Client[]
  invoices  Invoice[]
  followUps FollowUp[]
  payments     Payment[]
  subscription Subscription?

  @@index([createdAt])
}

model Client {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  company     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices  Invoice[]

  // Composite identity makes the workspace boundary part of the database key.
  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
}

model Invoice {
  id          String        @id @default(cuid())
  workspaceId String
  clientId    String
  title       String
  amountCents Int
  currency    String        @default("USD")
  dueDate     DateTime
  status      InvoiceStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  followUps FollowUp[]
  payments  Payment[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, clientId])
}

model FollowUp {
  id          String          @id @default(cuid())
  workspaceId String
  invoiceId   String
  template    FollowUpTemplate
  message     String
  sentAt      DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, invoiceId, sentAt])
}

model Payment {
  id          String   @id @default(cuid())
  workspaceId String
  invoiceId   String
  amountCents Int
  paidAt      DateTime @default(now())
  method      String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, invoiceId, paidAt])
}

model Subscription {
  id                   String   @id @default(cuid())
  workspaceId           String   @unique
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  plan                 Plan     @default(FREE)
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, plan])
  @@index([currentPeriodEnd])
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum InvoiceStatus {
  OPEN
  OVERDUE
  PAID
}

enum FollowUpTemplate {
  GENTLE
  PROFESSIONAL
  FINAL
}
