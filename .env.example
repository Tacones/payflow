# Public app configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk authentication
# Provision these values through the Clerk/Vercel integration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database
# Keep the real connection string only in Vercel/local environment variables.
DATABASE_URL=

# Billing (future)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Never commit real values to Git.

# Server-side admin allowlist. Add your verified Clerk email after creating your owner account.
PAYFLOW_ADMIN_EMAILS=
# Optional stronger alternative: comma-separated Clerk user IDs.
PAYFLOW_ADMIN_USER_IDS=
